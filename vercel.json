{
  "version": 2,
  "builds": [
    {
      "src": "api/save-content.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/save-content",
      "dest": "/api/save-content.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
